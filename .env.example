# backend/.env 로 복사해 값을 채운다. .env는 커밋하지 않는다.
ENVIRONMENT=development

# Supabase 프로젝트 설정 > API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 레거시 HS256 JWT secret을 쓰는 프로젝트만. 비우면 SUPABASE_URL의 JWKS로 검증한다 (로컬 supabase start는 ES256이라 비운다)
SUPABASE_JWT_SECRET=

# 배포 프론트 출처 (쉼표로 여러 개)
CORS_ORIGINS=

# B4·B5
GOOGLE_PLACES_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# 로컬 DB 테스트 (tests/db). 비우면 DB 테스트는 건너뛴다
DATABASE_URL_TEST=
